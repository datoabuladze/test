# Copy to /var/www/nebulo/shared/.env and fill in. Never commit the real file.
APP_NAME=Nebulo
APP_ENV=production
APP_KEY=            # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://www.example.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=pgsql   # or mariadb
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=nebulo
DB_USERNAME=nebulo
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=redis
QUEUE_CONNECTION=redis
# Must exceed the longest job timeout (imports: 1800 s) or jobs run twice.
REDIS_QUEUE_RETRY_AFTER=1900
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

PLATFORM_BRAND=Nebulo
LEGAL_OPERATOR=
CONTACT_EMAIL=
LEGAL_JURISDICTION=
GAMES_ORIGIN=https://play.example-games.net
VISITOR_HASH_SALT=
GA4_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
ADSENSE_CLIENT=
TRUSTED_PROXIES=127.0.0.1
